{
  "name": "inky-paper",
  "private": true,
  "version": "0.6.4",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-workbench-mcp.mjs && vite --host 127.0.0.1 --port 1422",
    "build": "node scripts/build-workbench-mcp.mjs && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
